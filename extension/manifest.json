{
  "name": "M.I.T. Consulting Token signing",
  "key": "",
  "version": "1.1.0",
  "manifest_version": 3,
  "default_locale": "cs",
  "description": "__MSG_extenstionDescription__",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}