// Batch signing PIN dialogs in the same layout as on Linux and macOS: heading with the logo,
// content over the full width, owner drawn buttons in a footer. Separate from PinDialog.rc used by SIGN.

#include "BatchPinDialogResource.h"
#include "winres.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

// Token PIN
IDD_BATCH_PIN DIALOGEX 0, 0, 280, 143
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "MIT Token signing"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_BATCH_HEADING,14,12,196,16,SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "",IDC_BATCH_ICON,"Static",SS_OWNERDRAW,214,9,52,21
    LTEXT           "",IDC_BATCH_NAME,14,36,252,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "",IDC_BATCH_DETAILS,14,47,252,10,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_ERROR,14,58,252,10,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_LABEL,14,77,252,10,SS_NOPREFIX
    EDITTEXT        IDC_BATCH_PIN,14,88,252,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "OK",IDOK,"Button",BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED,160,120,50,16
    CONTROL         "Cancel",IDCANCEL,"Button",BS_OWNERDRAW | WS_TABSTOP,216,120,50,16
END

// Token PIN and digital signature PIN, the box that they are the same disables the second field
IDD_BATCH_PIN2 DIALOGEX 0, 0, 280, 182
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "MIT Token signing"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_BATCH_HEADING,14,12,196,16,SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "",IDC_BATCH_ICON,"Static",SS_OWNERDRAW,214,9,52,21
    LTEXT           "",IDC_BATCH_NAME,14,36,252,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "",IDC_BATCH_DETAILS,14,47,252,10,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_ERROR,14,58,252,10,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_LABEL,14,77,252,10,SS_NOPREFIX
    EDITTEXT        IDC_BATCH_PIN,14,88,252,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "",IDC_BATCH_SAME,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,14,107,252,10
    LTEXT           "",IDC_BATCH_LABEL2,14,121,252,10,SS_NOPREFIX
    EDITTEXT        IDC_BATCH_PIN2,14,132,252,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "OK",IDOK,"Button",BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED,160,159,50,16
    CONTROL         "Cancel",IDCANCEL,"Button",BS_OWNERDRAW | WS_TABSTOP,216,159,50,16
END

// Digital signature PIN after the token rejected the one of the token PIN dialog,
// the explanation has three lines
IDD_BATCH_SIGNPIN DIALOGEX 0, 0, 280, 160
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_TOPMOST
CAPTION "MIT Token signing"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_BATCH_HEADING,14,12,196,16,SS_NOPREFIX | SS_ENDELLIPSIS
    CONTROL         "",IDC_BATCH_ICON,"Static",SS_OWNERDRAW,214,9,52,21
    LTEXT           "",IDC_BATCH_NAME,14,36,252,10,SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "",IDC_BATCH_DETAILS,14,47,252,30,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_ERROR,14,80,252,10,SS_NOPREFIX
    LTEXT           "",IDC_BATCH_LABEL,14,94,252,10,SS_NOPREFIX
    EDITTEXT        IDC_BATCH_PIN,14,105,252,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "OK",IDOK,"Button",BS_OWNERDRAW | WS_TABSTOP | WS_DISABLED,160,137,50,16
    CONTROL         "Cancel",IDCANCEL,"Button",BS_OWNERDRAW | WS_TABSTOP,216,137,50,16
END
