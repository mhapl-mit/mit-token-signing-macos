<!--
"%WIX%\bin\candle.exe" chrome-token-signing.wxs -dVERSION=1.0.0
"%WIX%\bin\light.exe" -out chrome-token-signing.msi chrome-token-signing.wixobj -ext WixUIExtension
    -dWixUILicenseRtf=LICENSE.LGPL.rtf
    -dWixUIDialogBmp=dlgbmp.bmp
-->

<?ifndef Platform ?>
<?define Platform="x64" ?>
<?endif ?>

<?if $(var.Platform) = x64 ?>
  <?define Win64 = "yes" ?>
<?else ?>
  <?define Win64 = "no" ?>
<?endif ?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Name="MIT Token Signing" UpgradeCode="3e52954d-eee4-4dd8-a4f2-318521e3dbd9"
      Id="*" Language="1029" Version="$(var.VERSION)" Codepage="1250" Manufacturer="M.I.T. Consulting, s.r.o.">
    <Package Platform="$(var.Platform)" Keywords="Installer" InstallerVersion="405" Compressed="yes"
      Languages="1029" SummaryCodepage="1250" Description="MIT Token Signing"/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>
    <Icon Id="Icon.ico" SourceFile="host-windows\icon_mit.ico"/>
    <Property Id="ARPPRODUCTICON" Value="Icon.ico"/>
    <Property Id="FORCEINSTALL" Value="1"/>
    <Property Id="CHROMEINSTALL" Value="1"/>
    <Property Id="EDGEINSTALL" Value="1"/>
    <Property Id="EDGEFORCEINSTALL" Value="1"/>
    <!-- No Firefox custom actions (open-eid FirefoxAction.CA.dll): while a version carrying them was
         being upgraded they ran unelevated, could not write HKLM\Software\Policies\Mozilla and the upgrade
         failed with 1603; they also forced the open-eid add-on token-signing2 into Firefox. Firefox is not
         supported yet. The released 1.1.2.0 (5. 3. 2021) was built without them as well. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage=
      "Je nainstalovaná novější verze [ProductName]. Pro instalaci starší verze ji nejdřív odinstalujte."/>
    <Condition Message="[ProductName] vyžaduje Windows 7 nebo novější.">
      <![CDATA[Installed OR (VersionNT >= 601)]]>
    </Condition>

    <!-- Czech UI (light -cultures:cs-cz), no license page: Welcome -> Install -> progress -> finish.
         Based on WixUI_Minimal of WiX 3, the welcome dialog with license replaced by WelcomeDlg. -->
    <WixVariable Id="WixUIDialogBmp" Value="host-windows\dialog.bmp"/>
    <WixVariable Id="WixUIBannerBmp" Value="host-windows\banner.bmp"/>
    <UI Id="MitTokenSigningUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8"/>
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12"/>
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes"/>
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
      <Property Id="WixUI_Mode" Value="Minimal"/>
      <DialogRef Id="ErrorDlg"/>
      <DialogRef Id="FatalError"/>
      <DialogRef Id="FilesInUse"/>
      <DialogRef Id="MsiRMFilesInUse"/>
      <DialogRef Id="PrepareDlg"/>
      <DialogRef Id="ProgressDlg"/>
      <DialogRef Id="ResumeDlg"/>
      <DialogRef Id="UserExit"/>
      <DialogRef Id="WelcomeDlg"/>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="1">NOT Installed</Publish>
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2">Installed</Publish>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999">1</Publish>
      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg">1</Publish>
      <Property Id="ARPNOMODIFY" Value="1"/>
      <!-- Status line of the progress dialog, Windows Installer has it only in English -->
      <ProgressText Action="InstallValidate">Ověřování instalace</ProgressText>
      <ProgressText Action="InstallInitialize">Příprava instalace</ProgressText>
      <ProgressText Action="RemoveExistingProducts">Odebírání předchozí verze</ProgressText>
      <ProgressText Action="ProcessComponents">Registrace součástí</ProgressText>
      <ProgressText Action="UnpublishFeatures">Odebírání registrace funkcí</ProgressText>
      <ProgressText Action="RemoveRegistryValues">Odebírání hodnot registru</ProgressText>
      <ProgressText Action="RemoveFiles">Odebírání souborů</ProgressText>
      <ProgressText Action="InstallFiles">Kopírování souborů</ProgressText>
      <ProgressText Action="WriteRegistryValues">Zápis do registru</ProgressText>
      <ProgressText Action="RegisterUser">Registrace uživatele</ProgressText>
      <ProgressText Action="RegisterProduct">Registrace produktu</ProgressText>
      <ProgressText Action="PublishFeatures">Registrace funkcí</ProgressText>
      <ProgressText Action="PublishProduct">Registrace produktu</ProgressText>
      <ProgressText Action="InstallFinalize">Dokončování instalace</ProgressText>
      <ProgressText Action="Rollback">Vracení změn</ProgressText>
    </UI>
    <UIRef Id="WixUI_Common"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id='ProgramFilesFolder'>
        <Directory Id="APPLICATIONFOLDER" Name="MIT Token Signing">
          <Component Id="Application" Guid="85baa771-7c73-49bb-b546-ab6a4520d258" Win64="no">
            <File Source="host-windows/Release/chrome-token-signing.exe"/>
          </Component>


          <!--Important to extension be able to communicate with native client-->
          <Component Id="ChromeEdge" Transitive="yes" >
            <Condition><![CDATA[(CHROMEINSTALL = 1 OR EDGEINSTALL = 1)]]></Condition>
            <File Source="host-windows/cz.mit.consulting.json"/>
            <RegistryValue Root='HKLM' Type='string' Value='[APPLICATIONFOLDER]cz.mit.consulting.json'
                Key='SOFTWARE\Google\Chrome\NativeMessagingHosts\cz.mit.consulting'/>
          </Component>

          <!--CHROME EXTENSTION COMPONENT - install chrome extension via registry-->

          <!-- <Component Id="Chrome" Transitive="yes" >
            <Condition><![CDATA[(CHROMEINSTALL = 1)]]></Condition>
            <RegistryValue Root='HKLM' Type='string' Name="update_url"
                Key='SOFTWARE\Google\Chrome\Extensions\hkckiflbaedpdigcjoeiacmfnlncpeoj'
                Value='https://clients2.google.com/service/update2/crx'/>
          </Component> -->


          <!--EDGE EXTENSTION COMPONENT - install edge extension via registry-->
          <!-- <Component Id="Edge" Transitive="yes" >
            <Condition><![CDATA[(EDGEINSTALL = 1)]]></Condition>
            <RegistryValue Root='HKLM' Type='string' Name="update_url"
                Key='Software\Microsoft\Edge\Extensions\ajndpmmgagjlfgoegeadcgkiehlbcinl'
                Value='https://edge.microsoft.com/extensionwebstorebase/v1/crx'/>
          </Component> -->


          <!-- FIREFOX-->
          
          <!-- <Component Id="FirefoxApplication" Guid="8c52d631-7da9-46d3-89c6-8248f94fa25c" Transitive="yes" >
            <Condition><![CDATA[(FIREFOXINSTALL = 1)]]></Condition>
            <File Source="host-windows/cz.mit.consulting.firefox.json"/>
          </Component> -->


          <!-- Pokud chceme zavest group policy (uzivatel nebude moct extension vypnout) odkomotuj tyhle rady + Componenty-->
          <!-- <Component Id="ForceInstall" Guid="b02ebb46-a515-4821-82af-29f8c6073544" Win64="no" Transitive="yes">
            <Condition><![CDATA[(FORCEINSTALL = 1 AND CHROMEINSTALL = 1)]]></Condition>
            <RegistryValue Root='HKLM' Type='string' Name="56789"
                Key='SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist'
                Value='hkckiflbaedpdigcjoeiacmfnlncpeoj'/>
          </Component>
          <Component Id="EdgeForceInstall" Guid="00ced5f1-1b35-4b76-be1e-cbe1784aac88" Win64="no" Transitive="yes">
            <Condition><![CDATA[(EDGEFORCEINSTALL = 1 AND EDGEINSTALL = 1)]]></Condition>
            <RegistryValue Root='HKLM' Type='string' Name="56789"
                Key='SOFTWARE\Policies\Microsoft\Edge\ExtensionInstallForcelist'
                Value='ajndpmmgagjlfgoegeadcgkiehlbcinl'/>
          </Component> -->
        </Directory>
      </Directory>

      <!-- FIREFOX-->
      <!-- <Component Id="Firefox" Guid="60c6e502-529b-4d28-9e92-4cdbf1176afb" Win64="$(var.Win64)" Transitive="yes" >
        <Condition><![CDATA[(FIREFOXINSTALL = 1)]]></Condition>
        <RegistryValue Root='HKLM' Type='string' Value='[APPLICATIONFOLDER]cz.mit.consulting.firefox.json'
            Key='SOFTWARE\Mozilla\NativeMessagingHosts\cz.mit.consulting' />
      </Component> -->
    </Directory>

    <Feature Id="Install" Level="1" Title="MIT Token Signing" Display="expand" ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentRef Id="Application"/>
      <!-- <ComponentRef Id="ForceInstall"/> -->
      <!-- <ComponentRef Id="Firefox"/>
      <ComponentRef Id="FirefoxApplication"/> -->
      <ComponentRef Id="ChromeEdge"/>
      <!-- <ComponentRef Id="Chrome"/>
      <ComponentRef Id="Edge"/> -->
      <!-- <ComponentRef Id="EdgeForceInstall"/> -->
    </Feature>
  </Product>
</Wix>
